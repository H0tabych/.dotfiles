{
  "mcpServers": {
    "lsp-python": {
      "type": "stdio",
      "command": "code-context-lsp",
      "args": [
        "python"
      ]
    },
    "lsp-cpp": {
      "type": "stdio",
      "command": "code-context-lsp",
      "args": [
        "cpp"
      ]
    },
    "lsp-rust": {
      "type": "stdio",
      "command": "code-context-lsp",
      "args": [
        "rust"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": []
    },
    "gateway": {
      "type": "http",
      "url": "${AI_MCP_URL}",
      "headers": {
        "x-bf-vk": "${AI_MCP_KEY}"
      }
    }
  }
}
