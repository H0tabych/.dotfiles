// Портативный конфиг waybar (DOT-3). Вертикальная панель, зоны 6.1 DESIGN_SYSTEM.md
// (DSN-S5, R6.8). Батарея/мониторы — автоопределение waybar, машинный слой не
// требуется (DOT-5: include нужен только там, где без него нельзя).
// Иконки — через \uXXXX (набор Font Awesome, в шрифте символов — font.symbols
// в palette.toml), а не буквальным символом: при прямой вставке глиф терялся
// и поле уходило пустым (найдено на машине 2026-10-15 — "сеть пропала с панели").
{
    "layer": "top",
    "position": "left",
    "width": 44,
    "margin": "12 0 12 8",
    "spacing": 6,

    // Зона 1 (Навигация) — всегда видна (DSN-LAY-3).
    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    // Зона 2 (Внимание) — только при активном событии/режиме.
    "modules-center": ["privacy", "custom/dnd", "idle_inhibitor", "mpris"],
    // Зона 3 (Состояние, всегда кроме капсулы «ещё») + зона 4 (Время и питание).
    "modules-right": [
        "hyprland/language", "custom/tunnel", "network", "pulseaudio", "battery",
        "group/more", "clock", "custom/power"
    ],

    "custom/launcher": {
        "format": "",
        "tooltip-format": "Приложения",
        "on-click": "pgrep -x rofi >/dev/null && pkill rofi || rofi -show drun"
    },
    // DSN-LAY-3: рабочие столы на виду, пока в них что-то есть/активны —
    // штатное поведение модуля (persistent-workspaces снят: раньше показывал
    // все 10 постоянно и, по живой проверке, терял интерактивность у
    // непосещённых столов). Числом, не глифом — не зависит от покрытия шрифта.
    "hyprland/workspaces": {
        "format": "{id}"
    },

    // DSN-LAY-2 зона 2: индикаторы приватности (запись экрана, микрофон, камера).
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 16,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },
    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/dnd",
        "return-type": "json",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "makoctl mode -t do-not-disturb"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" }
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": { "default": "" },
        "status-icons": { "paused": "" },
        "max-length": 0
    },

    // DSN-LAY-2 зона 3: раскладка/туннель/сеть/звук/батарея — всегда; «ещё» — по наведению.
    "hyprland/language": { "format-en": "EN", "format-ru": "RU" },
    "custom/tunnel": {
        "exec": "~/.config/waybar/scripts/tunnel",
        "return-type": "json",
        "interval": 15
    },
    // DSN-LAY-10: SSID — переменный длинный текст, в панели только иконка;
    // имя сети — в подсказке (иначе растягивает 44px колонку вширь).
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "eth: {ifname}",
        "tooltip-format-disconnected": "сеть недоступна"
    },
    // Значение — только в подсказке (наведение), в панели — одна цветная
    // иконка: подпись цифрой рядом с иконкой дублировала её и забивала узкую
    // 44px колонку (замечание на машине 2026-10-15). Цвет — по states
    // (DSN-S5): ПРОВЕРЕНО на живой панели — порог срабатывает при value <= N
    // (а не >=, как мог бы предполагать man waybar-states; выставлял volume
    // 5%/95% — класс срабатывал ровно наоборот задуманному), поэтому класс
    // назван "low" и красит тихий звук, не громкий. .muted — отдельный класс
    // модуля (встроенный, не из states).
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "{icon}",
        "format-icons": {
            "default": ["", "", ""],
            "default-muted": ""
        },
        "states": { "low": 20 },
        "tooltip-format": "{volume}%",
        "on-click": "swayosd-client --output-volume mute-toggle"
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}%"
    },
    "group/more": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 250 },
        "modules": ["custom/more", "backlight", "tray"]
    },
    "custom/more": {
        "format": "",
        "tooltip-format": "Ещё: яркость, трей"
    },
    "backlight": {
        "format": "{icon}\n{percent}",
        "format-icons": [""]
    },
    // bluetooth (DSN-S5, R6.8, исправление): отдельного модуля "bluetooth"
    // здесь больше нет — дублировал значок трея (bluetooth-manager-blueman.nix:
    // аплет blueman уже кладёт свою иконку в #tray, по замыслу самой фичи —
    // "значок в трее отображает существующий модуль tray"; на машине
    // 2026-10-15 оба значка оказались рядом одновременно).
    "tray": { "spacing": 8 },

    // Зона 4: время и питание — всегда.
    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/power": {
        "format": "",
        "tooltip-format": "Меню питания",
        "on-click": "~/.config/rofi/scripts/power"
    }
}
