// Портативный конфиг waybar (DOT-3). Вертикальная панель, зоны 6.1 DESIGN_SYSTEM.md
// (DSN-S5, R6.8). Батарея/мониторы — автоопределение waybar, машинный слой не
// требуется (DOT-5: include нужен только там, где без него нельзя).
// Иконки — через \uXXXX, а не буквальным символом: при прямой вставке глиф
// терялся и поле уходило пустым (найдено на машине 2026-10-15 — "сеть пропала
// с панели"). Набор смешанный (Font Awesome, Material Design, Font Logos) —
// всё в одном шрифте символов (font.symbols в palette.toml, Nerd Fonts Symbols
// Only уже включает все наборы разом).
{
    "layer": "top",
    "position": "left",
    "width": 44,
    "margin": "12 0 12 8",
    "spacing": 6,

    // Зона 1 (Навигация) — всегда видна (DSN-LAY-3).
    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    // Зона 2 (Внимание) — только при активном событии/режиме.
    "modules-center": ["privacy", "custom/dnd", "idle_inhibitor", "mpris"],
    // Зона 3 (Состояние, всегда кроме капсулы «ещё») + зона 4 (Время и питание).
    // Три смысловые пары — каждая в одной капсуле (style.css): net-status
    // (язык/туннель/сеть — «где я и как подключён»), sound-light (звук/яркость
    // — настройки вывода) и vitals (заряд/ЦП/память — «жива ли машина и чем
    // занята»; перегруппировка 2026-10-21 — батарея раньше была в net-status,
    // но по смыслу она не про связь, а про состояние самой машины, как и
    // загрузка). group/more — своя капсула, по наведению; остальное
    // (launcher/privacy/dnd/idle/mpris/clock/power) — по одному, см. style.css.
    "modules-right": [
        "group/net-status", "group/sound-light", "group/vitals", "group/more", "clock", "custom/power"
    ],
    // Без "drawer" — это не капсула «ещё» (не прячет содержимое), просто общий
    // фон для нескольких модулей; CSS-id группы — имя после "group/" (#net-
    // status, #sound-light, #vitals), а не "group/…" целиком (ПРОВЕРЕНО
    // исходником Waybar, src/bar.cpp: Group(id_name, …) → box.set_name(id_name)).
    "group/net-status": {
        "orientation": "inherit",
        "modules": ["hyprland/language", "custom/tunnel", "network"]
    },
    "group/sound-light": {
        "orientation": "inherit",
        "modules": ["backlight", "pulseaudio"]
    },
    "group/vitals": {
        "orientation": "inherit",
        "modules": ["battery", "cpu", "memory"]
    },

    "custom/launcher": {
        "format": "",
        "tooltip-format": "Приложения",
        "on-click": "pgrep -x rofi >/dev/null && pkill rofi || rofi -show drun"
    },
    // DSN-LAY-3: рабочие столы на виду, пока в них что-то есть/активны —
    // штатное поведение модуля (persistent-workspaces снят: раньше показывал
    // все 10 постоянно и, по живой проверке, терял интерактивность у
    // непосещённых столов). Числом, не глифом — не зависит от покрытия шрифта.
    // {windows} — реальные иконки приложений темы (workspace-taskbar), не
    // глифы по regex (window-rewrite): не нужно вручную сопоставлять класс
    // окна с иконкой. orientation: vertical — иначе ряд иконок растягивает
    // 44px колонку вширь (тот же принцип, что и у network/pulseaudio ниже,
    // DSN-LAY-10); max-icons — предохранитель от разрастания столбца вниз,
    // если в одном воркспейсе открыто много окон. format-window-separator —
    // пустым: по умолчанию "  " (пробел) — man waybar(5) утверждает, что в
    // режиме workspace-taskbar он игнорируется, но живой исходник (ПРОВЕРЕНО,
    // src/modules/hyprland/workspace.cpp) вставляет его между иконками
    // безусловно — без явного "" между иконками были лишние пустые строки.
    // on-click-window (M24, исправление 2026-10-21) — клик по значку окна:
    // переходит на его стол и фокусирует окно. Без параметра waybar вообще не
    // подключает обработчик к кнопке окна (ПРОВЕРЕНО исходником, src/modules/
    // hyprland/workspace.cpp: сигнал подключается только при непустом
    // on-click-window), а кнопки .taskbar-window растянуты на всю ширину капсулы —
    // клик по значку умирал. Команда исполняется через `sh -c` (ПРОВЕРЕНО
    // include/util/command.hpp), hyprctl лежит в PATH юнита (bar-waybar.nix),
    // HYPRLAND_INSTANCE_SIGNATURE есть в окружении процесса. Форма — Lua, а не
    // легаси-текст: Hyprland 0.55.4 с Lua-конфигом исполняет payload сокета как
    // Lua (подробности и патч самого waybar — в bar-waybar.nix). Строка Lua в
    // одинарных кавычках, чтобы не экранировать двойные внутри JSON; {address}
    // waybar подставляет уже с префиксом 0x (ПРОВЕРЕНО исходником), селектор
    // address:0x… Lua-API принимает (ПРОВЕРЕНО пробой: чужой адрес даёт
    // «window not found», а не ошибку разбора).
    "hyprland/workspaces": {
        "format": "{id}\n{windows}",
        "format-window-separator": "",
        "workspace-taskbar": {
            "enable": true,
            "orientation": "vertical",
            "icon-size": 18,
            "max-icons": 5,
            "on-click-window": "hyprctl dispatch \"hl.dsp.focus({ window = 'address:{address}' })\""
        }
    },

    // DSN-LAY-2 зона 2: индикаторы приватности (запись экрана, микрофон, камера).
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },
    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/dnd",
        "return-type": "json",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "makoctl mode -t do-not-disturb"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" }
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": { "default": "" },
        "status-icons": { "paused": "" },
        "max-length": 0
    },

    // DSN-LAY-2 зона 3: раскладка/туннель/сеть/яркость/звук/батарея — всегда; «ещё» — по наведению.
    "hyprland/language": { "format-en": "EN", "format-ru": "RU" },
    "custom/tunnel": {
        "exec": "~/.config/waybar/scripts/tunnel",
        "return-type": "json",
        "interval": 15
    },
    // DSN-LAY-10: SSID — переменный длинный текст, в панели только иконка;
    // имя сети — в подсказке (иначе растягивает 44px колонку вширь).
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "eth: {ifname}",
        "tooltip-format-disconnected": "сеть недоступна"
    },
    // Иконка — 7 ступеней яркости (format-icons без alt, та же индексация
    // getIcon, что у pulseaudio); значение — только в подсказке, не подписью
    // под иконкой (как было раньше с "{icon}\n{percent}" — занимало строку в
    // узкой 44px колонке). 5 states (s20..s100) — не для текста, а под плавный
    // градиент цвета серый→жёлтый в style.css (чем мельче шаг states, тем
    // меньше скачок цвета между соседними уровнями). ПРОВЕРЕНО исходником
    // Waybar (src/modules/backlight.cpp вызывает getState(percent) без
    // lesser=true) — направление порога тут обратное battery/pulseaudio:
    // срабатывает при value >= N, "s100" — верхний порог; см. style.css.
    "backlight": {
        "states": { "s20": 20, "s40": 40, "s60": 60, "s80": 80, "s100": 100 },
        "format": "{icon}",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "tooltip-format": "{percent}%"
    },
    // Значение — только в подсказке (наведение), в панели — одна цветная
    // иконка (3 ступени громкости — встроенное авто-индексирование format-icons
    // по percentage, см. исходник Waybar ALabel::getIcon; подпись цифрой рядом
    // с иконкой дублировала её и забивала узкую 44px колонку, замечание на
    // машине 2026-10-15). Цвет — по states (DSN-S5): ПРОВЕРЕНО исходником
    // Waybar (src/modules/pulseaudio.cpp вызывает getState(volume, true)) —
    // порог срабатывает при value <= N (а не >=, как мог бы предполагать man
    // waybar-states), поэтому "low"/"medium" красят тихий/средний звук, а
    // громкий (выше "medium") остаётся без класса — цвет для него в style.css.
    // .muted — отдельный класс модуля (встроенный, не из states).
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "{icon}",
        "format-icons": {
            "default": ["", "", ""],
            "default-muted": ""
        },
        "states": { "low": 20, "medium": 60 },
        "tooltip-format": "{volume}%",
        "on-click": "swayosd-client --output-volume mute-toggle"
    },
    // Иконка — по уровню заряда (ПРОВЕРЕНО исходником Waybar, ALabel::getIcon:
    // индекс массива растёт от 0 при 0% к последнему при 100%, т.е. порядок
    // "default" — от пустой до полной, а не наоборот, как было раньше).
    // Ключи charging/plugged/"not charging"/full — статусы, которые battery.cpp
    // лопает в нижний регистр и подставляет как ключ format-icons (ПРОВЕРЕНО
    // исходником, src/modules/battery.cpp); на этой машине при полной зарядке
    // от сети статус — буквально "Full" (живая проверка: cat
    // /sys/class/power_supply/BAT1/status), без этого ключа он выглядел бы
    // так же, как разряжающийся акб на 100% — отсюда и жалоба "не видно
    // разницы". Массив с молнией одинаков для всех четырёх — у JSON нет
    // якорей/ссылок (копия, не ошибка). Цвет иконки — те же классы
    // critical/warning/good, что и без сети (см. style.css).
    "battery": {
        "states": { "critical": 10, "warning": 25, "good": 100 },
        "format": "{icon}",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "plugged": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "not charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "full": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰁹"]
        },
        "tooltip-format": "{capacity}%"
    },
    // Загрузка ЦП и памяти (DSN-LAY-2 зона 3, группа vitals). Цифр на панели
    // нет (запрос 2026-10-21) — только значок, цвет пятиступенчатый
    // (DSN-LAY-5): норма (0-19%, @text) -> rising(20) -> elevated(40) ->
    // busy(60) -> warning(70) -> critical(90). Пороги states срабатывают при
    // значении >= порога (man waybar-states(5): «equal to or greater» для
    // всех модулей, кроме батареи), цвета — в style.css через mix().
    // tooltip-format у cpu нет (ПРОВЕРЕНО исходником, src/modules/cpu.cpp:
    // подсказка штатная — загрузка по ядрам), у memory есть
    // (src/modules/memory/common.cpp) — туда же добавлен процент, раз его
    // больше нет на панели. interval: у ЦП 3 с — иначе всплески не видны; у
    // памяти 10 с — она так быстро не меняется. Значки — fa-microchip
    // (U+F2DB, cpu) и fa-memory (U+EFC5, memory), не md-cpu_64_bit/md-memory,
    // как раньше (запрос 2026-10-21 "подобрать подходящие, слишком похожи
    // друг на друга"): у md-cpu_64_bit и md-memory одинаковый силуэт —
    // квадратный чип с ножками по всем сторонам, на вид не различить; у пары
    // fa- силуэты разные (чип с ножками сверху/снизу — модуль памяти
    // горизонтальной плашкой), визуально проверено рендером глифов через
    // Pillow (не на глаз — у символов Nerd Font нет превью в этом
    // инструментарии). Оба глифа — в font.symbols (ПРОВЕРЕНО: fonttools,
    // SymbolsNerdFontMono-Regular.ttf, контур есть у обоих).
    "cpu": {
        "interval": 3,
        "format": "",
        "states": { "rising": 20, "elevated": 40, "busy": 60, "warning": 70, "critical": 90 }
    },
    "memory": {
        "interval": 10,
        "format": "",
        "states": { "rising": 20, "elevated": 40, "busy": 60, "warning": 70, "critical": 90 },
        "tooltip-format": "{percentage}% · {used:0.1f} / {total:0.1f} ГиБ"
    },
    "group/more": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 250 },
        "modules": ["custom/more", "tray"]
    },
    "custom/more": {
        "format": "",
        "tooltip-format": "Ещё: трей"
    },
    // bluetooth (DSN-S5, R6.8, исправление): отдельного модуля "bluetooth"
    // здесь больше нет — дублировал значок трея (bluetooth-manager-blueman.nix:
    // аплет blueman уже кладёт свою иконку в #tray, по замыслу самой фичи —
    // "значок в трее отображает существующий модуль tray"; на машине
    // 2026-10-15 оба значка оказались рядом одновременно).
    "tray": { "spacing": 8 },

    // Зона 4: время и питание — всегда.
    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/power": {
        "format": "",
        "tooltip-format": "Меню питания",
        "on-click": "~/.config/rofi/scripts/power"
    }
}
