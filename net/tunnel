#!/usr/bin/env bash
# net/tunnel (NET-13, VPN-OPS-2, DSN-LAY-5): состояние и переключение маршрута
# туннеля. Работает с контрактом подсистемы — юнитом route-switch@<маршрут>.service и
# файлом состояния, имени реализации туннеля здесь нет (SLOT-3). Пути и список юнитов
# клиента — из машинного слоя ~/.config/machine.d/tunnel-env (DOT-5, DESK-9); без него
# (хост без route-switch) скрипт молчит, а индикатор скрыт.
#
#   tunnel route         tunnel | direct
#   tunnel health        none | ok | direct | down
#   tunnel set <route>   tunnel | direct (пароль спрашивает агент polkit — каждый раз)
#
# health (DSN-LAY-5): ok — норма; direct — «внимание», защита снята; down —
# «критично»: клиент не работает или в маршруте tunnel нет связи с выходом;
# none — на хосте нет route-switch.
set -euo pipefail

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/machine.d/tunnel-env"
# shellcheck disable=SC1090
[ -r "$env_file" ] && . "$env_file"

# Проверка связи в маршруте tunnel: любой короткий ответ 204 через то, что система
# считает путём наружу (M2 — виртуальный интерфейс, M1 — прокси сессии). Результат
# кэшируется на 20 с, чтобы опрос панели не ходил в сеть каждые 5 с.
probe_url="${TUNNEL_PROBE_URL:-https://cp.cloudflare.com/generate_204}"
probe_file="${XDG_RUNTIME_DIR:-/tmp}/tunnel-probe"

current_route() {
  local value=""
  [ -r "${TUNNEL_ROUTE_STATE:-}" ] && value="$(tr -d '[:space:]' <"$TUNNEL_ROUTE_STATE")"
  # Любое значение, кроме direct, — tunnel (VPN-MOD-9).
  if [ "$value" = direct ]; then echo direct; else echo tunnel; fi
}

client_active() {
  local unit
  for unit in ${TUNNEL_ROUTE_UNITS:-}; do
    systemctl is-active --quiet "$unit" || return 1
  done
}

probe_ok() {
  local now age=999 result=ok
  now="$(date +%s)"
  if [ -r "$probe_file" ]; then
    read -r result stamp <"$probe_file" || true
    age=$((now - ${stamp:-0}))
  fi
  if [ "$age" -gt 20 ]; then
    if curl -fsS --max-time 3 -o /dev/null "$probe_url" 2>/dev/null; then result=ok; else result=fail; fi
    printf '%s %s\n' "$result" "$now" >"$probe_file"
  fi
  [ "$result" = ok ]
}

health() {
  if [ -z "${TUNNEL_ROUTE_STATE:-}" ]; then
    echo none
    return
  fi
  if ! client_active; then
    echo down
  elif [ "$(current_route)" = direct ]; then
    echo direct
  elif probe_ok; then
    echo ok
  else
    echo down
  fi
}

set_route() {
  case "${1:-}" in
    tunnel | direct) ;;
    *)
      echo "usage: tunnel set tunnel|direct" >&2
      exit 2
      ;;
  esac
  # Пароль спрашивает агент polkit при каждом вызове — разрешение не удерживается.
  systemctl start "route-switch@$1.service"
}

case "${1:-health}" in
  health) health ;;
  set) set_route "${2:-}" ;;
  route) current_route ;;
  *)
    echo "usage: tunnel route|health|set <route>" >&2
    exit 2
    ;;
esac
