// Портативный конфиг rofi (DOT-3). L3, режимы drun/window/emoji (DSN-S5, R6.8);
// буфер обмена и питание — отдельные команды (см. REGISTRY.md / hyprland.lua
// бинды), не отдельные modi.
@import "theme.rasi"

// configuration{}.font — опция ядра rofi (-font), требует буквальную строку,
// не ссылку на переменную темы (ошибка на машине 2026-10-15: "Option: font
// needs to be set with a string not a Reference"). Шрифт уже задан буквальной
// строкой генератором в theme.rasi (блок * { font: … } — DSN-TOK-8), этого
// достаточно для всех виджетов; configuration.font не нужен.
configuration {
    modi: "drun,window,emoji";
    show-icons: true;
}

window {
    width: 560px;
    padding: @pad-launcher;
    border: 1px;
    border-color: @glass-rim;
    border-radius: @radius-window;
    background-color: @glass-popup;
}

mainbox {
    background-color: transparent;
}

inputbar {
    border-radius: @radius-control;
    background-color: @surface0;
    text-color: @text;
    padding: 8px;
}

listview {
    background-color: transparent;
    lines: 8;
}

element {
    padding: 6px;
    background-color: transparent;
    text-color: @text;
    border-radius: @radius-control;
}

/* element { background-color: transparent; } выше не действует на реальные
   строки: rofi 2.0.0 применяет более специфичные "element normal.normal" /
   "element alternate.normal" из встроенной Solarized-темы (var(lightbg) —
   кремовый), которые перебивают общий блок element (сверено `rofi -dump-theme`,
   DSN-S5/R6.8 — исправление). Перекрываем явно все normal/alternate-состояния. */
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @text;
}
element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @error;
}
element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @accent;
}
element selected, element selected.normal, element selected.urgent, element selected.active {
    background-color: @accent;
    text-color: @on-accent;
}
