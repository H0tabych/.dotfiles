// Портативный конфиг rofi (DOT-3). L3, режимы drun/window/emoji (DSN-S5, R6.8);
// буфер обмена и питание — отдельные команды (см. REGISTRY.md / hyprland.lua
// бинды), не отдельные modi.
@import "theme.rasi"

// configuration{}.font — опция ядра rofi (-font), требует буквальную строку,
// не ссылку на переменную темы (ошибка на машине 2026-10-15: "Option: font
// needs to be set with a string not a Reference"). Шрифт уже задан буквальной
// строкой генератором в theme.rasi (* { font: "Inter 13"; } — DSN-TOK-8),
// этого достаточно для всех виджетов; configuration.font не нужен.
configuration {
    modi: "drun,window,emoji";
    show-icons: true;
}

window {
    width: 560px;
    padding: @pad-launcher;
    border: 1px;
    border-color: @glass-rim;
    border-radius: @radius-window;
    background-color: @glass-popup;
}

mainbox {
    background-color: transparent;
}

inputbar {
    border-radius: @radius-control;
    background-color: @surface0;
    text-color: @text;
    padding: 8px;
}

listview {
    background-color: transparent;
    lines: 8;
}

element {
    padding: 6px;
    text-color: @text;
    border-radius: @radius-control;
}

element selected {
    background-color: @accent;
    text-color: @on-accent;
}
