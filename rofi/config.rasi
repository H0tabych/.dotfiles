// Портативный конфиг rofi (DOT-3).
@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "monospace 12";
}

window {
    background-color: @mantle;
    text-color: @text;
    border: 2px;
    border-color: @accent;
    border-radius: 6px;
    width: 40%;
}

mainbox {
    background-color: @mantle;
}

inputbar {
    background-color: @surface0;
    text-color: @text;
    padding: 8px;
}

listview {
    background-color: @mantle;
    lines: 8;
}

element {
    padding: 6px;
    text-color: @text;
}

element selected {
    background-color: @accent;
    text-color: @on_accent;
}
