/* Сгенерировано theme/gen/gen.py из theme/palette.toml (вариант tree, профиль ac) — не редактируйте */
* {
    crust:    #070D12;
    mantle:   #0A141B;
    base:     #0E1A22;
    surface0: #16252F;
    surface1: #1F313D;
    surface2: #2A3F4D;
    overlay0: #4A6070;
    overlay1: #839AA5;
    subtext0: #A6B7BF;
    subtext1: #BECAD0;
    text:     #DCE7EC;

    accent:      #7FD6B0;
    accent-warm: #F2A988;
    on-accent:   #070D12;

    success: #B5DB86;
    warning: #F0B86E;
    error:   #F0817F;
}
