/* Сгенерировано theme/gen/generate.sh из theme/palette.toml — не редактируйте руками. */
* {
    background:  #1e1e2e;
    foreground:  #cdd6f4;
    accent:      #8caaee;
    black:       #45475a;
    red:         #e78284;
    green:       #a6d189;
    yellow:      #e5c890;
    blue:        #8caaee;
    magenta:     #f4b8e4;
    cyan:        #81c8be;
    white:       #b5bfe2;
}
