// Настройки Zed ведёт сам Zed (интерфейс записывает сюда изменения), файл НЕ генерируется
// (REGISTRY.md). Генерируется только тема themes/glass-tide.json (theme/gen). Шрифты здесь не
// задаются: имена шрифтов вне генератора запрещены (DSN-TOK-8) — действуют умолчания Zed.
{
  "agent": {
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:1.5b-base",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "theme": { "mode": "dark", "dark": "Glass Tide", "light": "Glass Tide" },

  // Телеметрия и автообновление выключены: пакет ставит Nix (DOT-2).
  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_update": false,
  "vim_mode": true,

  // AI-CMP-8: локальный инференс. Zed не читает окружение, поэтому адрес и модель — литералом
  // (роль local-fast из machine.d/ai-env: qwen2.5-coder:1.5b-base). Схема — zed.dev/docs/ai/edit-prediction.
  "edit_predictions": {
    "provider": "ollama",
    "ollama": { "api_url": "http://127.0.0.1:11434", "model": "qwen2.5-coder:1.5b-base", "prompt_format": "infer" }
  }
}
