@define-color crust ${crust};
@define-color mantle ${mantle};
@define-color base ${base};
@define-color surface0 ${surface0};
@define-color surface1 ${surface1};
@define-color surface2 ${surface2};
@define-color overlay0 ${overlay0};
@define-color overlay1 ${overlay1};
@define-color subtext0 ${subtext0};
@define-color subtext1 ${subtext1};
@define-color text ${text};

@define-color accent ${accent};
@define-color accent_warm ${accent_warm};
@define-color on_accent ${on_accent};

@define-color success ${success};
@define-color warning ${warning};
@define-color error ${error};
@define-color info ${info};
@define-color special ${special};

@define-color glass_bar alpha(@base, ${glass_bar});
@define-color glass_rim alpha(@text, ${glass_rim});
@define-color glass_popup alpha(@base, ${glass_popup});

/* Панель и окно сети (eww, слот bar; DSN-LAY-1…5, DSN-CMP-4). Файл целиком —
   токены и статика вместе, как mako/config: eww читает один CSS, а относительный
   @import в нём не разрешается. Меняйте здесь (theme/gen/templates), затем
   запускайте theme/gen/gen.py. Цвета — только токены (DSN-COL-1). */
* {
    all: unset;
}

/* Шрифт и цвет наследуются вниз от окна. DSN-CMP-4: шрифт UI md/500 — здесь,
   а не в других файлах (DSN-TOK-8). */
window {
    background-color: transparent;
    color: @text;
    font-family: "${font_ui}";
    font-size: ${size_md}px;
    font-weight: ${weight_glass};
}

tooltip {
    background-color: @mantle;
    border: 1px solid @glass_rim;
    border-radius: ${radius_control}px;
    padding: 4px 8px;
}

tooltip label {
    color: @text;
}

/* L1: панель — одна стеклянная капсула на весь столбец (DSN-LAY-1). Размытие —
   правилом слоя композитора (hyprland.lua, namespace eww-bar). */
.bar {
    background-color: @glass_bar;
    border: 1px solid @glass_rim;
    border-radius: ${radius_window}px;
    padding: 4px 0;
}

/* «Коробочка» состояния: одна на модуль или на смысловую группу. Ширина панели
   44 − 2×1 (рамка) − 2×4 (поля) = 34 px. */
.cap {
    background-color: @surface0;
    border-radius: ${radius_control}px;
    margin: 2px 4px;
    padding: 4px 0;
}

.cap label {
    padding: 4px 0;
}

.ico {
    font-size: 13px;
}

/* Фирменный синий NixOS (снежинка) — цвет чужого бренда, не состояние UI. */
.launcher {
    color: #5277C3;
}

/* Рабочие столы: капсула на стол; номер и иконки окон (≤ 5). */
.ws {
    background-color: @surface0;
    border-radius: ${radius_control}px;
    margin: 2px 4px;
    padding: 4px 0;
}

.ws-num {
    padding: 4px 0;
}

.ws-win {
    padding: 3px 0;
}

.ws.active {
    background-color: @surface1;
}

.ws.active .ws-num {
    color: @accent;
}

.ws.urgent {
    background-color: @error;
    color: @on_accent;
}

.ws.urgent .ws-num {
    color: @on_accent;
}

/* Зона 2: внимание. */
.privacy .ico {
    color: @warning;
}

.ico.active {
    color: @accent;
}

/* Сеть (DSN-LAY-5): норма — text; direct — «внимание» (+ значок тревоги, второй
   канал, DSN-COL-8); нет связи — «критично», капсула error. */
.net.ok {
    color: @text;
}

.net.offline {
    color: @subtext0;
}

.net.direct {
    color: @warning;
}

.net.down {
    color: @on_accent;
    background-color: @error;
    border-radius: 999px;
}

/* Bluetooth: включён — голубой (info), выключен — приглушён. */
.bt.off {
    color: @subtext0;
}

.bt.on,
.bt.connected {
    color: @info;
}

.layout-text {
    font-weight: 600;
}

/* Батарея: цвет по уровню заряда; критично — капсула error. */
.bat.good {
    color: @success;
}

.bat.warning {
    color: @warning;
}

.bat.critical {
    color: @on_accent;
    background-color: @error;
    border-radius: 999px;
}

/* Звук: тихо — error, средне — warning, громко — success (DSN-LAY-5). */
.vol {
    color: @success;
}

.vol.medium {
    color: @warning;
}

.vol.low,
.vol.muted {
    color: @error;
}

/* Яркость: плавный переход overlay0 → warning (тусклый экран — не тревога). */
.bright {
    color: @overlay0;
}

.bright.s20 {
    color: mix(@overlay0, @warning, 0.2);
}

.bright.s40 {
    color: mix(@overlay0, @warning, 0.4);
}

.bright.s60 {
    color: mix(@overlay0, @warning, 0.6);
}

.bright.s80 {
    color: mix(@overlay0, @warning, 0.8);
}

.bright.s100 {
    color: @warning;
}

/* ЦП и память: только цвет, без капсулы error — высокая загрузка это рабочий
   режим (сборка, игра, инференс), а не тревога (решение 2026-10-21). Ступени —
   mix(text, warning, порог / 70). */
.load.rising {
    color: mix(@text, @warning, 0.286);
}

.load.elevated {
    color: mix(@text, @warning, 0.571);
}

.load.busy {
    color: mix(@text, @warning, 0.857);
}

.load.warning {
    color: @warning;
}

.load.critical {
    color: @error;
}

.power .ico {
    color: @error;
}

.tray image {
    padding: 4px 0;
    margin: 0 8px;
}

/* ---------------------------------------------------------------- окно сети -- */

.panel {
    background-color: @glass_popup;
    border: 1px solid @glass_rim;
    border-radius: ${radius_window}px;
    padding: ${pad_launcher}px;
}

.panel-title {
    font-size: ${size_lg}px;
    font-weight: 600;
}

.icon-btn {
    padding: 4px 8px;
    border-radius: ${radius_control}px;
}

.icon-btn:hover,
.net:hover,
.seg:hover {
    background-color: @surface1;
}

.sect-title {
    color: @subtext0;
    font-size: ${size_sm}px;
}

.sect.row {
    padding: 2px 0;
}

.segs {
    background-color: @surface0;
    border-radius: ${radius_control}px;
    padding: 2px;
}

.seg {
    padding: 8px;
    border-radius: ${radius_control}px;
}

.seg label {
    padding: 0;
}

.seg.active,
.seg.active:hover {
    background-color: @accent;
    color: @on_accent;
}

.confirm {
    padding-top: 4px;
}

.warn {
    color: @warning;
}

.btn {
    background-color: @surface0;
    border-radius: ${radius_control}px;
    padding: 6px 12px;
}

.btn.danger {
    background-color: @error;
    color: @on_accent;
}

.switch {
    background-color: @surface1;
    border-radius: 999px;
    min-width: 44px;
    min-height: 24px;
    padding: 2px;
}

.switch.on {
    background-color: @accent;
}

.knob {
    background-color: @text;
    border-radius: 999px;
    min-width: 20px;
    min-height: 20px;
}

.nets {
    min-height: 120px;
}

.net {
    padding: 8px;
    border-radius: ${radius_control}px;
}

.net.active {
    background-color: @surface1;
}

.msg,
.muted {
    color: @subtext0;
}

.ico.ok {
    color: @success;
}

.ico.dim {
    color: @overlay0;
}

.catcher {
    background-color: transparent;
}
