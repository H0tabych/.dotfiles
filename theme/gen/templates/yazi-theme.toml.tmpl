# Сгенерировано theme/gen/generate.sh из theme/palette.toml — не редактируйте руками.

[manager]
cwd = { fg = "__accent__" }

hovered         = { reversed = true }
preview_hovered = { underline = true }

find_keyword  = { fg = "__yellow__", italic = true }
find_position = { fg = "__magenta__", bg = "reset", italic = true }

marker_copied   = { fg = "__green__", bg = "__green__" }
marker_cut      = { fg = "__red__", bg = "__red__" }
marker_marked   = { fg = "__blue__", bg = "__blue__" }
marker_selected = { fg = "__accent__", bg = "__accent__" }

tab_active   = { fg = "__background__", bg = "__accent__" }
tab_inactive = { fg = "__foreground__", bg = "__black__" }

border_symbol = "│"
border_style  = { fg = "__black__" }

[status]
separator_open  = ""
separator_close = ""

mode_normal = { fg = "__background__", bg = "__accent__", bold = true }
mode_select = { fg = "__background__", bg = "__green__", bold = true }
mode_unset  = { fg = "__background__", bg = "__magenta__", bold = true }

progress_label  = { fg = "__foreground__", bold = true }
progress_normal = { fg = "__accent__", bg = "__black__" }
progress_error  = { fg = "__red__", bg = "__black__" }

permissions_t = { fg = "__blue__" }
permissions_r = { fg = "__yellow__" }
permissions_w = { fg = "__red__" }
permissions_x = { fg = "__green__" }
permissions_s = { fg = "__black__" }

[input]
border   = { fg = "__accent__" }
title    = {}
value    = {}
selected = { reversed = true }

[select]
border = { fg = "__accent__" }
active = { fg = "__accent__" }
inactive = {}

[tasks]
border  = { fg = "__accent__" }
title   = {}
hovered = { underline = true }

[which]
mask            = { bg = "__background__" }
cand            = { fg = "__cyan__" }
rest            = { fg = "__black__" }
desc            = { fg = "__accent__" }
separator       = "  "
separator_style = { fg = "__black__" }

[help]
on      = { fg = "__cyan__" }
run     = { fg = "__accent__" }
desc    = { fg = "__black__" }
hovered = { bg = "__black__", bold = true }
footer  = { fg = "__foreground__", bg = "__black__" }
