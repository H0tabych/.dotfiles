[mgr]
cwd = { fg = "${accent}" }

# R6.9, ПРОВЕРИТЬ: было reversed = true — инверсия цвета конфликтовала с
# вылезающим краем иконки (overflowing-glyphs=yes, умолчание foot) и давала
# полукруг поверх значка текущей строки; прямой bg — попытка обойти это
# без глобального твика foot (который калечит иконки сильнее).
hovered         = { bg = "${surface1}" }
preview_hovered = { underline = true }

find_keyword  = { fg = "${warning}", italic = true }
find_position = { fg = "${special}", bg = "reset", italic = true }

marker_copied   = { fg = "${success}", bg = "${success}" }
marker_cut      = { fg = "${error}", bg = "${error}" }
marker_marked   = { fg = "${info}", bg = "${info}" }
marker_selected = { fg = "${accent}", bg = "${accent}" }

# ПРОВЕРИТЬ: имена count_* — по аналогии с marker_* (DESIGN_SYSTEM.md P.3.5
# упоминает только группу "count_*", без точных имён), не подтверждено живым
# запуском.
count_copied   = { fg = "${base}", bg = "${success}" }
count_cut      = { fg = "${base}", bg = "${error}" }
count_selected = { fg = "${base}", bg = "${accent}" }

border_symbol = "│"
border_style  = { fg = "${surface1}" }

[tabs]
active   = { fg = "${base}", bg = "${accent}" }
inactive = { fg = "${text}", bg = "${surface1}" }

[mode]
normal = { fg = "${base}", bg = "${accent}", bold = true }
select = { fg = "${base}", bg = "${success}", bold = true }
unset  = { fg = "${base}", bg = "${special}", bold = true }

[status]
separator_open  = ""
separator_close = ""

progress_label  = { fg = "${text}", bold = true }
progress_normal = { fg = "${accent}", bg = "${surface1}" }
progress_error  = { fg = "${error}", bg = "${surface1}" }

permissions_t = { fg = "${info}" }
permissions_r = { fg = "${warning}" }
permissions_w = { fg = "${error}" }
permissions_x = { fg = "${success}" }
permissions_s = { fg = "${surface1}" }

[input]
border   = { fg = "${accent}" }
title    = {}
value    = {}
selected = { reversed = true }

[select]
border = { fg = "${accent}" }
active = { fg = "${accent}" }
inactive = {}

[tasks]
border  = { fg = "${accent}" }
title   = {}
hovered = { underline = true }

[which]
mask            = { bg = "${base}" }
cand            = { fg = "${teal}" }
rest            = { fg = "${surface1}" }
desc            = { fg = "${accent}" }
separator       = "  "
separator_style = { fg = "${surface1}" }

[help]
on      = { fg = "${teal}" }
run     = { fg = "${accent}" }
desc    = { fg = "${surface1}" }
hovered = { bg = "${surface1}", bold = true }
footer  = { fg = "${text}", bg = "${surface1}" }

# [cmp], [notify], [filetype], [icon] — секции упомянуты DESIGN_SYSTEM.md
# P.3.5 как существующие в 26.5.6, но схема их полей не подтверждена; не
# заданы — yazi применяет собственные умолчания. ПРОВЕРИТЬ на живой системе.
#
# [indicator] убран (был добавлен в R6.9, снят в тот же день): current с
# bg = surface2 рисовал тёмный полукруг поверх значка текущей строки —
# подтверждено пользователем на живой системе. Штатная подсветка текущей
# строки у yazi (светлая, mgr.hovered) и так работает без этой настройки.
