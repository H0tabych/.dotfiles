{
  "$$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Glass Tide",
  "author": "nixos-config (theme/gen)",
  "themes": [
    {
      "name": "Glass Tide",
      "appearance": "dark",
      "style": {
        "border": "${surface1}",
        "border.variant": "${surface0}",
        "border.focused": "${accent}",
        "border.selected": "${accent}",
        "border.transparent": "#${base_raw}00",
        "border.disabled": "${surface0}",
        "elevated_surface.background": "${surface0}",
        "surface.background": "${mantle}",
        "background": "${mantle}",
        "element.background": "${surface0}",
        "element.hover": "${surface1}",
        "element.active": "${surface2}",
        "element.selected": "${surface2}",
        "element.disabled": "${surface0}",
        "drop_target.background": "#${accent_raw}33",
        "ghost_element.background": "#${base_raw}00",
        "ghost_element.hover": "${surface1}",
        "ghost_element.active": "${surface2}",
        "ghost_element.selected": "${surface2}",
        "ghost_element.disabled": "${surface0}",
        "text": "${text}",
        "text.muted": "${subtext0}",
        "text.placeholder": "${overlay1}",
        "text.disabled": "${overlay0}",
        "text.accent": "${accent}",
        "icon": "${subtext1}",
        "icon.muted": "${subtext0}",
        "icon.disabled": "${overlay0}",
        "icon.placeholder": "${overlay1}",
        "icon.accent": "${accent}",
        "status_bar.background": "${crust}",
        "title_bar.background": "${crust}",
        "title_bar.inactive_background": "${mantle}",
        "toolbar.background": "${base}",
        "tab_bar.background": "${mantle}",
        "tab.inactive_background": "${mantle}",
        "tab.active_background": "${base}",
        "search.match_background": "#${warning_raw}44",
        "panel.background": "${mantle}",
        "panel.focused_border": "${accent}",
        "pane.focused_border": "${accent}",
        "scrollbar.thumb.background": "#${overlay0_raw}66",
        "scrollbar.thumb.hover_background": "#${overlay1_raw}88",
        "scrollbar.thumb.border": "${surface1}",
        "scrollbar.track.background": "#${base_raw}00",
        "scrollbar.track.border": "${surface0}",
        "editor.foreground": "${text}",
        "editor.background": "${base}",
        "editor.gutter.background": "${base}",
        "editor.subheader.background": "${mantle}",
        "editor.active_line.background": "${surface0}",
        "editor.highlighted_line.background": "${surface0}",
        "editor.line_number": "${overlay0}",
        "editor.active_line_number": "${subtext1}",
        "editor.invisible": "${overlay0}",
        "editor.wrap_guide": "${surface1}",
        "editor.active_wrap_guide": "${surface2}",
        "editor.document_highlight.read_background": "#${accent_raw}22",
        "editor.document_highlight.write_background": "#${accent_raw}44",
        "terminal.background": "${base}",
        "terminal.foreground": "${text}",
        "terminal.bright_foreground": "${ansi_bright_7}",
        "terminal.dim_foreground": "${subtext0}",
        "terminal.ansi.black": "${ansi_regular_0}",
        "terminal.ansi.red": "${ansi_regular_1}",
        "terminal.ansi.green": "${ansi_regular_2}",
        "terminal.ansi.yellow": "${ansi_regular_3}",
        "terminal.ansi.blue": "${ansi_regular_4}",
        "terminal.ansi.magenta": "${ansi_regular_5}",
        "terminal.ansi.cyan": "${ansi_regular_6}",
        "terminal.ansi.white": "${ansi_regular_7}",
        "terminal.ansi.bright_black": "${ansi_bright_0}",
        "terminal.ansi.bright_red": "${ansi_bright_1}",
        "terminal.ansi.bright_green": "${ansi_bright_2}",
        "terminal.ansi.bright_yellow": "${ansi_bright_3}",
        "terminal.ansi.bright_blue": "${ansi_bright_4}",
        "terminal.ansi.bright_magenta": "${ansi_bright_5}",
        "terminal.ansi.bright_cyan": "${ansi_bright_6}",
        "terminal.ansi.bright_white": "${ansi_bright_7}",
        "link_text.hover": "${accent}",
        "conflict": "${warning}",
        "conflict.background": "#${warning_raw}22",
        "conflict.border": "${warning}",
        "created": "${success}",
        "created.background": "#${success_raw}22",
        "created.border": "${success}",
        "deleted": "${error}",
        "deleted.background": "#${error_raw}22",
        "deleted.border": "${error}",
        "error": "${error}",
        "error.background": "#${error_raw}22",
        "error.border": "${error}",
        "hidden": "${overlay0}",
        "hint": "${overlay1}",
        "hint.background": "#${info_raw}22",
        "hint.border": "${info}",
        "ignored": "${overlay0}",
        "info": "${info}",
        "info.background": "#${info_raw}22",
        "info.border": "${info}",
        "modified": "${warning}",
        "modified.background": "#${warning_raw}22",
        "modified.border": "${warning}",
        "predictive": "${overlay1}",
        "predictive.background": "#${overlay0_raw}22",
        "predictive.border": "${surface2}",
        "renamed": "${info}",
        "renamed.background": "#${info_raw}22",
        "renamed.border": "${info}",
        "success": "${success}",
        "success.background": "#${success_raw}22",
        "success.border": "${success}",
        "unreachable": "${overlay0}",
        "unreachable.background": "${mantle}",
        "unreachable.border": "${surface1}",
        "warning": "${warning}",
        "warning.background": "#${warning_raw}22",
        "warning.border": "${warning}",
        "players": [
          { "cursor": "${accent}", "background": "${accent}", "selection": "#${accent_raw}44" },
          { "cursor": "${special}", "background": "${special}", "selection": "#${special_raw}44" },
          { "cursor": "${info}", "background": "${info}", "selection": "#${info_raw}44" },
          { "cursor": "${teal}", "background": "${teal}", "selection": "#${teal_raw}44" },
          { "cursor": "${warning}", "background": "${warning}", "selection": "#${warning_raw}44" },
          { "cursor": "${error}", "background": "${error}", "selection": "#${error_raw}44" }
        ],
        "syntax": {
          "attribute": { "color": "${warning}" },
          "boolean": { "color": "${accent_warm}", "font_weight": 600 },
          "comment": { "color": "${overlay1}", "font_style": "italic" },
          "comment.doc": { "color": "${overlay1}", "font_style": "italic" },
          "constant": { "color": "${accent_warm}" },
          "constructor": { "color": "${teal}" },
          "embedded": { "color": "${text}" },
          "emphasis": { "color": "${accent}", "font_style": "italic" },
          "emphasis.strong": { "color": "${accent}", "font_weight": 700 },
          "enum": { "color": "${teal}" },
          "function": { "color": "${info}" },
          "hint": { "color": "${overlay1}" },
          "keyword": { "color": "${special}", "font_weight": 600 },
          "label": { "color": "${accent}" },
          "link_text": { "color": "${info}" },
          "link_uri": { "color": "${accent}", "font_style": "italic" },
          "number": { "color": "${accent_warm}" },
          "operator": { "color": "${subtext1}" },
          "predictive": { "color": "${overlay1}", "font_style": "italic" },
          "preproc": { "color": "${warning}" },
          "primary": { "color": "${text}" },
          "property": { "color": "${text}" },
          "punctuation": { "color": "${subtext1}" },
          "punctuation.bracket": { "color": "${subtext1}" },
          "punctuation.delimiter": { "color": "${subtext0}" },
          "punctuation.list_marker": { "color": "${accent}" },
          "punctuation.special": { "color": "${special}" },
          "string": { "color": "${success}" },
          "string.escape": { "color": "${special}" },
          "string.regex": { "color": "${warning}" },
          "string.special": { "color": "${special}" },
          "string.special.symbol": { "color": "${special}" },
          "tag": { "color": "${special}" },
          "text.literal": { "color": "${success}" },
          "title": { "color": "${accent}", "font_weight": 700 },
          "type": { "color": "${teal}" },
          "variable": { "color": "${text}" },
          "variable.special": { "color": "${accent_warm}" },
          "variant": { "color": "${teal}" }
        }
      }
    }
  ]
}
