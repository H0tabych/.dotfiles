/* Тема Glass Tide для Obsidian (CSS-сниппет, DSN-CMP-17): положить в
   <хранилище>/.obsidian/snippets/glass-tide.css и включить в Настройки → Внешний вид →
   CSS-сниппеты. Окно сплошное (DSN-EXC-3). */
.theme-dark {
  --background-primary: ${base};
  --background-primary-alt: ${mantle};
  --background-secondary: ${mantle};
  --background-secondary-alt: ${crust};
  --background-modifier-border: ${surface1};
  --background-modifier-border-hover: ${surface2};
  --background-modifier-hover: ${surface1};
  --background-modifier-active-hover: ${surface2};
  --background-modifier-form-field: ${surface0};
  --background-modifier-cover: #${crust_raw}CC;
  --text-normal: ${text};
  --text-muted: ${subtext0};
  --text-faint: ${overlay1};
  --text-on-accent: ${on_accent};
  --text-accent: ${accent};
  --text-accent-hover: ${accent};
  --text-selection: #${accent_raw}44;
  --text-highlight-bg: #${warning_raw}44;
  --text-error: ${error};
  --text-warning: ${warning};
  --text-success: ${success};
  --interactive-accent: ${accent};
  --interactive-accent-hover: ${accent};
  --interactive-normal: ${surface0};
  --interactive-hover: ${surface1};
  --color-red: ${error};
  --color-orange: ${accent_warm};
  --color-yellow: ${warning};
  --color-green: ${success};
  --color-cyan: ${teal};
  --color-blue: ${info};
  --color-purple: ${special};
  --font-interface-theme: "${font_ui}";
  --font-text-theme: "${font_ui}";
  --font-monospace-theme: "${font_mono}";
  --radius-s: ${radius_control}px;
  --radius-m: ${radius_control}px;
  --radius-l: ${radius_window}px;
}
