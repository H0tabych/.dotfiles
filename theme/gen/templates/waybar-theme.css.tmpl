@define-color crust ${crust};
@define-color mantle ${mantle};
@define-color base ${base};
@define-color surface0 ${surface0};
@define-color surface1 ${surface1};
@define-color surface2 ${surface2};
@define-color overlay0 ${overlay0};
@define-color overlay1 ${overlay1};
@define-color subtext0 ${subtext0};
@define-color subtext1 ${subtext1};
@define-color text ${text};

@define-color accent ${accent};
@define-color accent_warm ${accent_warm};
@define-color on_accent ${on_accent};

@define-color success ${success};
@define-color warning ${warning};
@define-color error ${error};
@define-color info ${info};
@define-color special ${special};

@define-color glass_bar alpha(@base, ${glass_bar});
@define-color glass_rim alpha(@text, ${glass_rim});

/* DSN-CMP-4: шрифт UI md/500 — здесь, а не в style.css (DSN-TOK-8 запрещает
   имя шрифта вне сгенерированных файлов). */
* {
    font-family: "${font_ui}";
    font-size: ${size_md}px;
    font-weight: ${weight_glass};
}

/* Скругление панели — radius.window (shape), то же значение, что у окон
   Hyprland (hyprland.lua: decoration.rounding) и rofi (theme.rasi:
   radius-window). Раньше style.css задавал 999px (капсула) буквально —
   визуально сильнее скруглено, чем окна (замечание на машине 2026-10-15). */
window#waybar {
    border-radius: ${radius_window}px;
}
