# Полная раскладка по зонам/уровням (L3/L5, критические уведомления) — DSN-S5.

sort=-time
layer=overlay
anchor=top-right
width=${notify_width}
margin=10
padding=12
border-size=${border_rim}
border-radius=${radius_window}
default-timeout=${notify_timeout}
ignore-timeout=false

background-color=${base}
text-color=${text}
border-color=${accent}
progress-color=over ${accent}

[urgency=low]
border-color=${overlay0}

[urgency=critical]
border-color=${error}
default-timeout=0
