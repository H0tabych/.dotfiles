#!/usr/bin/env bash
# act <переменная>... -- <команда...>: выполнить команду, затем сразу обновить
# переменные eww (defpoll), не дожидаясь их интервала. Запускается через bg.
set -u
vars=()
while [ $# -gt 0 ] && [ "$1" != -- ]; do vars+=("$1"); shift; done
[ "${1:-}" = -- ] && shift
"$@"
rc=$?
[ ${#vars[@]} -gt 0 ] && eww poll "${vars[@]}" >/dev/null 2>&1
exit "$rc"
